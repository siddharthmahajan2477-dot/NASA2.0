ted_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://science.nasa.gov/mission/near-shoemaker/","target":"_blank","rel":"noopener noreferrer"},"NASA mission history"]],["LI",{},["A",{"href":"https://www.jhuapl.edu/destinations/missions/near","target":"_blank","rel":"noopener noreferrer"},"JHUAPL spacecraft and teams"]]]]],["DETAILS",{},["SUMMARY",{},"Six ways to ask about a rock"],["P",{},"X-ray/gamma-ray spectroscopy probes elemental composition. The laser rangefinder measures distance for shape and topography. The magnetometer investigates magnetic fields. Radio tracking constrains motion, gravity and mass distribution. Combine complementary measurements rather than assigning every result to a camera. Radio science uses communications tracking, not a separate camera."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Six ways to ask about a rock",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_13_"},"Narration speed"],["SELECT",{"id":"_r_13_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value