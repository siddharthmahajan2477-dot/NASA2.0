{},["A",{"href":"https://science.nasa.gov/resource/apollo-11-landing-site/","target":"_blank","rel":"noopener noreferrer"},"NASA · Apollo 11 landing site, LROC"]]]]]],[[31,1286]],["DETAILS",{"data-archive-record":"cabin"},["SUMMARY",{},"A cabin that could leave"," — ","Reference access; not yet discovered"],["P",{},"The upper stage carried the crew cabin and an engine of its own. After the surface stay, it took Armstrong and Aldrin back into lunar orbit to rendezvous with Columbia."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.nasa.gov/history/apollos-lunar-module-bridged-technological-leap-to-the-moon/","target":"_blank","rel":"noopener noreferrer"},"NASA · Lunar Module engineering"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/history/apollo-11-mission-overview/","target":"_blank","rel":"noopener noreferrer"},"NASA · Apollo 11 mission overview"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","A cabin that could leave",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_27_"},"Narration speed"],["SELECT",{"id":"_r_27_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":