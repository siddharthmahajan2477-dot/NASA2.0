ps://www.nasa.gov/history/50-years-ago-one-small-step-one-giant-leap/","target":"_blank","rel":"noopener noreferrer"},"NASA · Apollo 11 surface experiments"]],["LI",{},["A",{"href":"https://science.nasa.gov/wp-content/uploads/2023/09/Apollo_11.pdf","target":"_blank","rel":"noopener noreferrer"},"NASA · Apollo 11 press kit (PDF)"]],["LI",{},["A",{"href":"https://science.nasa.gov/resource/apollo-11-landing-site/","target":"_blank","rel":"noopener noreferrer"},"NASA · Apollo 11 landing site, LROC"]]]]],["DETAILS",{},["SUMMARY",{},"11",". ","Engineering challenges"],["P",{},"Apollo 11 followed earlier Apollo tests of spacecraft, lunar navigation and rendezvous. Its objective combined landing people on the Moon with returning them safely. Earlier missions reduced risk; they did not remove the uncertainties of the first landing."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Engineering challenges",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_a_"},"Narration speed"],["SELECT",{"id":"_r_a_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"