"rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"]],["LI",{},["A",{"href":"https://www.nasa.gov/news-release/after-three-years-on-mars-nasas-ingenuity-helicopter-mission-ends/","target":"_blank","rel":"noopener noreferrer"},"NASA · End of flight mission, January 25, 2024"]],["LI",{},["A",{"href":"https://science.nasa.gov/wp-content/uploads/2024/06/ingenuity-helicopter-flight-log.pdf","target":"_blank","rel":"noopener noreferrer"},"NASA · Completed flight log (PDF)"]]]]]],["H2",{},"Full mission reference chapters"],["DETAILS",{},["SUMMARY",{},"Mission objectives"],["P",{},"The original objective was to demonstrate powered, controlled flight in the Martian atmosphere. The planned five-flight experiment grew into operations demonstrations and further engineering tests. Its cameras supplied navigation observations and aerial imagery; it did not carry a Perseverance-style scientific instrument payload."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Mission objectives",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_i_"},"Narration speed"],["SELECT",{"id":"_r_i_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/ingenuity/landing/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Original demonstration objectives"]],["LI",{},["A",{"href":"https://science.nasa.gov/resource/the-legacy-of-ingenuity-the-frontier-of-extraterrestrial-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · The legacy of Ingenuity"]]]]],["DETAILS",{},["SUMMARY",{},"Spacecraft engineering"],["P",{},"The vehicle combined counter-rotating carbon-fibre rotors, an array above them, a compact electronics housing and four landing legs. Onboard computers, sensors, batteries and heaters supported autonomous flight and survival. Inspect the model for the visible arrangement, then read the individual engineering records below for the underlying systems."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Spacecraft engineering",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_j_"},"Narration speed"],["SELECT",{"id":"_r_j_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/mars_2020/ingenuity/landing/mission/spacecraft/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Spacecraft engineering"]]]]],["DETAILS",{},["SUMMARY",{},"People and collaborating teams"],["P",{},"JPL led system architecture and development, built the fuselage and integrated the aircraft. AeroVironment built the rotor system, landing gear and solar-panel substrate; SolAero integrated the panel. NASA Ames and Langley contributed rotorcraft analysis. MiMi Aung was project manager during the first-flight period. NASA’s December 2024 account identifies Teddy Tzanetos as project manager and Håvard Grip as Ingenuity’s first pilot. These are historical roles, not a current personnel directory."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","People and collaborating teams",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_k_"},"Narration speed"],["SELECT",{"id":"_r_k_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/mars_2020/ingenuity/landing/mission/spacecraft/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Spacecraft engineering"]],["LI",{},["A",{"href":"https://www.nasa.gov/solar-system/nasas-mars-helicopter-survives-first-cold-martian-night-on-its-own/","target":"_blank","rel":"noopener noreferrer"},"NASA · Surviving the first night alone"]],["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"]]]]],["DETAILS",{},["SUMMARY",{},"Achievements and historical significance"],["P",{},"Ingenuity demonstrated a new way of exploring another planet. Its flight record exceeded the initial plan and its imagery added an aerial viewpoint to rover exploration. Its primary contribution was technology and operations knowledge, alongside useful reconnaissance—not the discovery of life or the collection of samples."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Achievements and historical significance",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_l_"},"Narration speed"],["SELECT",{"id":"_r_l_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://science.nasa.gov/resource/the-legacy-of-ingenuity-the-frontier-of-extraterrestrial-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · The legacy of Ingenuity"]],["LI",{},["A",{"href":"https://science.nasa.gov/resource/ingenuity-mars-helicopter-by-the-numbers/","target":"_blank","rel":"noopener noreferrer"},"NASA · Ingenuity by the numbers"]]]]],["DETAILS",{},["SUMMARY",{},"Operational challenges"],["P",{},"Thin air made lift difficult. Nights required energy and thermal protection. Interplanetary communications made onboard control essential. Visual navigation relied on useful ground features. The evidence records explain how each challenge influenced design or operations; no single engineering choice solved all of them."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Operational challenges",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_m_"},"Narration speed"],["SELECT",{"id":"_r_m_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/ingenuity/landing/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Original demonstration objectives"]],["LI",{},["A",{"href":"https://science.nasa.gov/blog/its-cold-on-mars/","target":"_blank","rel":"noopener noreferrer"},"NASA · It’s Cold on Mars, April 2, 2021"]],["LI",{},["A",{"href":"https://science.nasa.gov/blog/what-were-learning-about-ingenuitys-flight-control-and-aerodynamic-performance/","target":"_blank","rel":"noopener noreferrer"},"NASA · Flight control and aerodynamic performance"]],["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"]]]]],["DETAILS",{},["SUMMARY",{},"Mission conclusion and legacy"],["P",{},"Flight 72 on January 18, 2024 was the final flight. NASA announced the end of the flight mission on January 25. A later investigation described the most-likely accident sequence while acknowledging uncertainty. The flight data, operational experience and limits that engineers identified remain useful for designing future aerial explorers."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Mission conclusion and legacy",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_n_"},"Narration speed"],["SELECT",{"id":"_r_n_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://www.nasa.gov/news-release/after-three-years-on-mars-nasas-ingenuity-helicopter-mission-ends/","target":"_blank","rel":"noopener noreferrer"},"NASA · End of flight mission, January 25, 2024"]],["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"]],["LI",{},["A",{"href":"https://science.nasa.gov/resource/the-legacy-of-ingenuity-the-frontier-of-extraterrestrial-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · The legacy of Ingenuity"]]]]],["DETAILS",{},["SUMMARY",{},"Sources, reconstruction and credits"],["P",{},"Spacecraft model: NASA/Brian E. Kumanchik. The intact NASA model, original procedural terrain and original teaching diagrams illustrate engineering concepts. The terrain is not surveyed Jezero topography. Diagrams are not real flight telemetry. No historical quotations, generated mission-control conversations or fabricated NASA photographs are used. This independent project is not affiliated with or endorsed by NASA."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Sources, reconstruction and credits",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_o_"},"Narration speed"],["SELECT",{"id":"_r_o_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{},["SUMMARY",{},"Scientific sources"],["UL",{},["LI",{},["A",{"href":"https://science.nasa.gov/3d-resources/ingenuity-mars-helicopter/","target":"_blank","rel":"noopener noreferrer"},"NASA/Brian E. Kumanchik · Ingenuity 3D model"]]]]],["H2",{},"Detailed evidence and engineering records"],["DETAILS",{"data-archive-record":"original-plan"},["SUMMARY",{},"An experiment with five flights"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Before the first flight · technology demonstration"],["P",{},"Ingenuity was sent to test powered, controlled flight on Mars. Up to five experimental flights were planned in a 30-day demonstration window. It was not a miniature version of Perseverance’s science laboratory."],["SECTION",{},["H4",{},"What counted as a useful result?"],["P",{},"Engineers needed evidence that a very light aircraft could take off, stay under control and land in the Martian atmosphere. Even a short flight would test a capability that had never been demonstrated on another planet."]],["SECTION",{},["H4",{},"Equipment and purpose"],["P",{},"The helicopter carried cameras, computers and sensors for flight and engineering observations, rather than a dedicated scientific instrument payload. Its small housing had to fit those systems alongside batteries and heaters."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","Judge the original mission against what it was designed to prove, rather than assuming it had a rover’s job."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/ingenuity/landing/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Original demonstration objectives"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/mars_2020/ingenuity/landing/mission/spacecraft/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Spacecraft engineering"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","An experiment with five flights",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_p_"},"Narration speed"],["SELECT",{"id":"_r_p_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"arrival"},["SUMMARY",{},"From a rover’s belly to open sky"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"February–April 2021 · arrival and deployment"],["P",{},"Ingenuity arrived at Jezero Crater beneath Perseverance on February 18, 2021. It was deployed onto the surface on April 3. After surviving on its own, it first flew on April 19."],["SECTION",{},["H4",{},"The first flight"],["P",{},"The autonomous test rose to about 3 metres, hovered, then landed. The flight lasted 39.1 seconds. The short journey answered a large engineering question: controlled powered flight on another planet was possible."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","Arrival, deployment and flight were separate achievements. A helicopter still attached to a rover had not yet proved it could fly."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://science.nasa.gov/mission/mars-2020-perseverance/ingenuity-mars-helicopter/","target":"_blank","rel":"noopener noreferrer"},"NASA · Ingenuity mission and timeline"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/news-release/nasas-ingenuity-mars-helicopter-succeeds-in-historic-first-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · Historic first flight, April 19, 2021"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/solar-system/nasas-mars-helicopter-survives-first-cold-martian-night-on-its-own/","target":"_blank","rel":"noopener noreferrer"},"NASA · Surviving the first night alone"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","From a rover’s belly to open sky",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_q_"},"Narration speed"],["SELECT",{"id":"_r_q_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"thin-air"},["SUMMARY",{},"Less air, less lift"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Flight environment · qualitative engineering explanation"],["P",{},"Mars has roughly one percent of Earth’s atmospheric density near the surface. Rotors have much less air to push against. Lower gravity reduces the aircraft’s weight, but does not remove the need to generate lift."],["FIGURE",{"class":"science-diagram"},["svg",{"viewBox":"0 0 360 145","role":"img","aria-label":"Illustrative lift diagram: two stacked rotors turn in opposite directions; lift acts upward and weight downward."},["path",{"d":"M180 40v65M60 60h240M85 82h190","stroke":"#bfced0","stroke-width":"4"}],["path",{"d":"M180 32V8l-6 8m6-8 6 8M180 111v25l-6-8m6 8 6-8M70 43q100-35 220 0l-8-13m8 13-16 2M85 98q95 28 190 0l-7 13m7-13-16-2","stroke":"#eccca0","fill":"none","stroke-width":"2"}],["text",{"x":"196","y":"19"},"Lift"],["text",{"x":"196","y":"135"},"Weight"],["text",{"x":"8","y":"128"},"Opposite rotation"]],["FIGCAPTION",{},"Illustrative engineering diagram. Not to scale; no flight telemetry or numerical simulation."]],["SECTION",{},["H4",{},"A linked design problem"],["P",{},"Large, rapidly turning blades and a lightweight vehicle help address the thin atmosphere. These choices work together. Lower gravity helps; it does not make a heavy vehicle with small, slow blades a safe substitute."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","The diagram shows relationships, not a calculator for real flight performance. No numerical flight physics is simulated."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/ingenuity/landing/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Original demonstration objectives"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Less air, less lift",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_r_"},"Narration speed"],["SELECT",{"id":"_r_r_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"rotor-control"},["SUMMARY",{},"Two rotors, opposite directions"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Rotor system · lift and control"],["P",{},"Two stacked rotors turn in opposite directions. Their opposing torques help prevent the body from simply spinning the other way. The blades are carbon-fibre structures, not solid heavy metal paddles."],["SECTION",{},["H4",{},"Control is more than speed"],["P",{},"Ingenuity controls flight by adjusting blade pitch: the angle at which blades meet the air. That changes lift and allows control of the aircraft. It is misleading to treat it as a consumer drone controlled only by changing motor speeds."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","Lift, torque and control solve different parts of the flight problem. The static model shows the engineering arrangement, not a running rotor simulation."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/mars_2020/ingenuity/landing/mission/spacecraft/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Spacecraft engineering"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://science.nasa.gov/blog/what-were-learning-about-ingenuitys-flight-control-and-aerodynamic-performance/","target":"_blank","rel":"noopener noreferrer"},"NASA · Flight control and aerodynamic performance"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Two rotors, opposite directions",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_s_"},"Narration speed"],["SELECT",{"id":"_r_s_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"sunlight"},["SUMMARY",{},"Daylight has another job"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Power system · energy must last beyond a flight"],["P",{},"The solar array above the rotors charges the lithium-ion battery system. Stored energy powers flight, electronics and heaters. Sunlight is a source; the battery stores energy for use when the panel is not producing it."],["FIGURE",{"class":"science-diagram"},["svg",{"viewBox":"0 0 360 145","role":"img","aria-label":"Illustrative energy path: sunlight charges the battery, which supplies heaters, electronics and flight motors."},["rect",{"x":"11","y":"40","width":"75","height":"42"}],["rect",{"x":"126","y":"40","width":"85","height":"42"}],["path",{"d":"M87 61h37m88 0h35M247 22v80m0-80h30m-30 40h30m-30 40h30","fill":"none","stroke":"#e2bd91","stroke-width":"2"}],["text",{"x":"16","y":"65"},"Sunlight"],["text",{"x":"136","y":"65"},"Battery"],["text",{"x":"280","y":"26"},"Heaters"],["text",{"x":"260","y":"66"},"Electronics"],["text",{"x":"280","y":"106"},"Motors"]],["FIGCAPTION",{},"Illustrative engineering diagram. Not to scale; no flight telemetry or numerical simulation."]],["SECTION",{},["H4",{},"One supply, several demands"],["P",{},"A flight and a cold night draw on the same stored resource. A useful planning strategy protects essential systems and checks the battery’s condition before committing energy to another flight. This is qualitative reasoning, not a historical power-allocation schedule."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","A successful landing still leaves the helicopter with an energy problem to solve."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://science.nasa.gov/resource/mars-helicopters-solar-array-as-seen-by-perseverances-mastcam-z/","target":"_blank","rel":"noopener noreferrer"},"NASA · Solar array and stored energy"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Daylight has another job",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_t_"},"Narration speed"],["SELECT",{"id":"_r_t_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"night-survival"},["SUMMARY",{},"Landing was not the end of the day"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"April 2021 · surviving without rover-supplied power"],["P",{},"After deployment, Ingenuity had to supply its own heater from its own battery. Insulation and heaters protected temperature-sensitive parts inside. The team checked overnight survival and recharging before flight preparations continued."],["SECTION",{},["H4",{},"Why the rover moved"],["P",{},"Perseverance moved clear so sunlight could reach the helicopter’s panel. The rover no longer supplied power through the old physical connection. Ingenuity needed to recharge and manage its own heat."]],["SECTION",{},["H4",{},"A careful trade-off"],["P",{},"Keeping the interior warmer consumes energy. Turning off essential protection to maximise flying time is not a sound survival strategy. Flight preparation also depends on temperatures and available charge."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","“It landed” and “it can survive until tomorrow” are different conclusions. Neither should be assumed from the other."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.nasa.gov/solar-system/nasas-mars-helicopter-survives-first-cold-martian-night-on-its-own/","target":"_blank","rel":"noopener noreferrer"},"NASA · Surviving the first night alone"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://science.nasa.gov/blog/its-cold-on-mars/","target":"_blank","rel":"noopener noreferrer"},"NASA · It’s Cold on Mars, April 2, 2021"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Landing was not the end of the day",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_u_"},"Narration speed"],["SELECT",{"id":"_r_u_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"autonomy"},["SUMMARY",{},"Instructions travel. Reflexes stay onboard."," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Flight operations · planning from Earth"],["P",{},"Earth teams planned flights and sent instructions. During flight, onboard software combined sensor information and controlled the helicopter. Communication delays ruled out an Earth operator making immediate joystick corrections."],["SECTION",{},["H4",{},"A plan is not a remote pilot"],["P",{},"People chose objectives and reviewed results, while the aircraft handled the rapid control decisions needed during flight. This division of work allowed a carefully prepared route to be flown without a live human pilot at Mars."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","The planning challenge here is an educational example. You are not piloting a historical flight or viewing real telemetry."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.nasa.gov/news-release/nasas-ingenuity-mars-helicopter-succeeds-in-historic-first-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · Historic first flight, April 19, 2021"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://science.nasa.gov/blog/what-were-learning-about-ingenuitys-flight-control-and-aerodynamic-performance/","target":"_blank","rel":"noopener noreferrer"},"NASA · Flight control and aerodynamic performance"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","Instructions travel. Reflexes stay onboard.",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_v_"},"Narration speed"],["SELECT",{"id":"_r_v_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"navigation"},["SUMMARY",{},"The ground becomes a reference"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Visual navigation · observations and estimation"],["P",{},"A downward-facing navigation camera tracked visible surface features between images. Together with other sensors, those observations helped estimate motion. Distinct features on relatively flat ground are easier to follow than smooth, repetitive sand."],["SECTION",{},["H4",{},"Reading the illustrative observations"],["P",{},"A cluster of separated pebbles gives recognizable points that can be compared between frames. A blank patch offers few points. Steep, repeating ripples also challenge assumptions about the ground. Texture alone does not prove that terrain is safe to land on."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","The three observation drawings are invented teaching diagrams, not NASA flight images. No precise camera lens is identified by a hotspot in this model."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/mars_2020/ingenuity/landing/mission/spacecraft/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Spacecraft engineering"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","The ground becomes a reference",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_10_"},"Narration speed"],["SELECT",{"id":"_r_10_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"operations-demo"},["SUMMARY",{},"A new job after five"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"After the demonstration · operations and scouting"],["P",{},"After the initial five flights, the mission moved into an operations demonstration. Ingenuity explored how an aerial viewpoint could help rover planning, including observations of terrain that was hard to assess from ground level."],["SECTION",{},["H4",{},"What changed?"],["P",{},"The technology demonstration asked whether flight worked. Continued operations asked how flight could contribute to exploration. Aerial images could inform choices about routes and interesting areas, while further flights supplied engineering experience."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","A broader role did not turn Ingenuity into a rover, a sample collector or a laboratory with new science instruments."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.nasa.gov/solar-system/planets/mars/nasas-ingenuity-mars-helicopter-reaches-a-total-of-30-minutes-aloft/","target":"_blank","rel":"noopener noreferrer"},"NASA · From test flights to aerial scouting"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://science.nasa.gov/resource/the-legacy-of-ingenuity-the-frontier-of-extraterrestrial-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · The legacy of Ingenuity"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","A new job after five",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_11_"},"Narration speed"],["SELECT",{"id":"_r_11_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]]],["DETAILS",{"data-archive-record":"seventy-two"},["SUMMARY",{},"The plan and the record"," — ","Reference access; not yet discovered"],["P",{"class":"record-context"},"Mission record · completed flights, not promised ones"],["P",{},"The original demonstration planned up to five flights. Ingenuity completed 72 across nearly three years. NASA records more than two hours of total flight time and a maximum altitude of about 24 metres."],["SECTION",{},["H4",{},"Useful milestones"],["P",{},"The first flight was April 19, 2021. The fifth flight on May 7 completed the initial flight series. NASA marks the fiftieth flight on April 13, 2023. The last was January 18, 2024. These are flight-history milestones, not stages of an animated simulation."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","Longevity matters because repeated operations test hardware, procedures and assumptions over time—not because a larger number automatically answers every scientific question."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://science.nasa.gov/resource/ingenuity-mars-helicopter-by-the-numbers/","target":"_blank","rel":"noopener noreferrer"},"NASA · Ingenuity by the numbers"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://science.nasa.gov/mission/mars-2020-perseverance/ingenuity-mars-helicopter/","target":"_blank","rel":"noopener noreferrer"},"NASA · Ingenuity mission and 