{"type":"before","callId":"kluo@779","startTime":141307.888,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => new Promise((resolve, reject) => {\n    const request = indexedDB.open('echoes.journey.v1', 1);\n    request.onupgradeneeded = () => request.result.createObjectStore('missions');\n    request.onerror = () => reject(request.error);\n    request.onsuccess = () => {\n      const db = request.result;\n      const tx = db.transaction('missions', 'readwrite');\n      tx.objectStore('missions').put({\n        version: 999,\n        missionId: 'apollo-11',\n        phase: 'complete'\n      }, 'apollo-11');\n      tx.oncomplete = () => {\n        db.close();\n        resolve();\n      };\n      tx.onerror = () => {\n        db.close();\n        reject(tx.error);\n      };\n    };\n  })","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
