iewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","The Five-Flight Gamble",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_5_"},"Narration speed"],["SELECT",{"id":"_r_5_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["OL",{"class":"objective-tracker","aria-label":"Current objectives"},["LI",{"data-done":"false"},["SPAN",{"aria-hidden":"true"},"○"],"Inspect Electronics housing",["SPAN",{"class":"sr-only"}," required"]],["LI",{"data-done":"false"},["SPAN",{"aria-hidden":"true"},"○"],"Collect An experiment with five flights",["SPAN",{"class":"sr-only"}," required"]],["LI",{"data-done":"false"},["SPAN",{"aria-hidden":"true"},"○"],"Collect From a rover’s belly to open sky",["SPAN",{"class":"sr-only"}," required"]],["LI",{"data-done":"false"},["SPAN",{"aria-hidden":"true"},"○"],"Validate the evidence-based reconstruction"]],["A",{"class":"quest-work-link","href":"#quest-workbench"},"Open evidence & reconstruction ↓"],[[9,14]]],[[9,20]],[[2,3]],["SECTION",{"id":"quest-workbench","class":"quest-workbench","aria-label":"Evidence and reconstruction"},["DIV",{"class":"workbench-intro"},["P",{"class":"eyebrow"},"FIELD RECORDS / ","0"," DISCOVERED"],["H2",{},"Inspect. Read. Make the connection."],["P",{},"Use the spacecraft above to inspect required components. Open the records below, then collect the evidence you need."]],["DIV",{"class":"evidence-grid"},["DETAILS",{"class":"evidence-card","data-collected":"false"},["SUMMARY",{},"An experiment with five flights",["SMALL",{},"Open record"]],["DIV",{"class":"evidence-body"},["P",{"class":"record-context"},"Before the first flight · technology demonstration"],["P",{},"Ingenuity was sent to test powered, controlled flight on Mars. Up to five experimental flights were planned in a 30-day demonstration window. It was not a miniature version of Perseverance’s science laboratory."],["SECTION",{},["H4",{},"What counted as a useful result?"],["P",{},"Engineers needed evidence that a very light aircraft could take off, stay under control and land in the Martian atmosphere. Even a short flight would test a capability that had never been demonstrated on another planet."]],["SECTION",{},["H4",{},"Equipment and purpose"],["P",{},"The helicopter carried cameras, computers and sensors for flight and engineering observations, rather than a dedicated scientific instrument payload. Its small housing had to fit those systems alongside batteries and heaters."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","Judge the original mission against what it was designed to prove, rather than assuming it had a rover’s job."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/ingenuity/landing/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Original demonstration objectives"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.jpl.nasa.gov/news/press_kits/mars_2020/ingenuity/landing/mission/spacecraft/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Spacecraft engineering"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["P",{"class":"record-requirement"},"First inspect ","Electronics housing"," using its existing hotspot or component list above."],["BUTTON",{"class":"text-button","disabled":""},"Collect evidence: An experiment with five flights"]]],["DETAILS",{"class":"evidence-card","data-collected":"false"},["SUMMARY",{},"From a rover’s belly to open sky",["SMALL",{},"Open record"]],["DIV",{"class":"evidence-body"},["P",{"class":"record-context"},"February–April 2021 · arrival and deployment"],["P",{},"Ingenuity arrived at Jezero Crater beneath Perseverance on February 18, 2021. It was deployed onto the surface on April 3. After surviving on its own, it first flew on April 19."],["SECTION",{},["H4",{},"The first flight"],["P",{},"The autonomous test rose to about 3 metres, hovered, then landed. The flight lasted 39.1 seconds. The short journey answered a large engineering question: controlled powered flight on another planet was possible."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","Arrival, deployment and flight were separate achievements. A helicopter still attached to a rover had not yet proved it could fly."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://science.nasa.gov/mission/mars-2020-perseverance/ingenuity-mars-helicopter/","target":"_blank","rel":"noopener noreferrer"},"NASA · Ingenuity mission and timeline"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/news-release/nasas-ingenuity-mars-helicopter-succeeds-in-historic-first-flight/","target":"_blank","rel":"noopener noreferrer"},"NASA · Historic first flight, April 19, 2021"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/solar-system/nasas-mars-helicopter-survives-first-cold-martian-night-on-its-own/","target":"_blank","rel":"noopener noreferrer"},"NASA · Surviving the first night alone"," ",["SPAN",{"class":"