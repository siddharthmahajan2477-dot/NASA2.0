"aria-hidden":"true"},"○"],"Collect A most-likely explanation",["SPAN",{"class":"sr-only"}," required"]],["LI",{"data-done":"false"},["SPAN",{"aria-hidden":"true"},"○"],[[300,117]]]],[[300,121]],[[300,123]]],[[309,20]],["DIV",{"class":"inspection-layout"},["DIV",{"class":"inspection-stage"},["DIV",{"class":"spacecraft-viewport","data-model-state":"loaded","data-camera-mode":"landing-legs","data-model-meshes":"35","data-model-materials":"10","data-model-textures":"8","data-model-triangles":"9124","data-camera-position":"6.798,0.930,6.748"},[[59,15]],["DIV",{"style":"position: relative; width: 100%; height: 100%; overflow: hidden; pointer-events: auto; touch-action: none;"},["DIV",{"style":"width: 100%; height: 100%;"},["CANVAS",{"__playwright_bounding_rect__":"{\"left\":61,\"top\":-2042.34375,\"right\":1079,\"bottom\":-1372.34375}","style":"display: block; width: 1018px; height: 670px; touch-action: auto;","data-engine":"three.js r180","width":"1018","height":"670"},[[307,2]]]]]],[[309,29]]],[[54,3]]],["SECTION",{"id":"quest-workbench","class":"quest-workbench","aria-label":"Evidence and reconstruction"},[[37,9]],["DIV",{"class":"evidence-grid"},["DETAILS",{"class":"evidence-card","data-collected":"false"},["SUMMARY",{},"A short hop to check the aircraft",["SMALL",{},"Open record"]],["DIV",{"class":"evidence-body"},["P",{"class":"record-context"},"January 18, 2024 · Flight 72"],["P",{},"Flight 72 was intended as a brief vertical flight to check systems and photograph the area after the preceding flight ended early. Ingenuity climbed to its planned height and began descending. Communications were lost near the end of the flight."],["SECTION",{},["H4",{},"Read a status report in its time"],["P",{},"The January 19 report described what was known immediately afterward. It was not yet the completed accident investigation. Later evidence and analysis changed what engineers could reasonably explain."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","A report written just after an event and a later investigation answer different questions."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://science.nasa.gov/blog/flight-72-status-update/","target":"_blank","rel":"noopener noreferrer"},"NASA/JPL · Flight 72 status, January 19, 2024"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://science.nasa.gov/wp-content/uploads/2024/06/ingenuity-helicopter-flight-log.pdf","target":"_blank","rel":"noopener noreferrer"},"NASA · Completed flight log (PDF)"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["BUTTON",{"class":"text-button"},"Collect evidence: A short hop to check the aircraft"]]],["DETAILS",{"class":"evidence-card","data-collected":"false"},["SUMMARY",{},"What the pictures established",["SMALL",{},"Open record"]],["DIV",{"class":"evidence-body"},["P",{"class":"record-context"},"After Flight 72 · observed damage"],["P",{},"Communications were reestablished the following day. Later imagery showed rotor-blade damage that ended Ingenuity’s ability to fly. The images establish damage; they do not provide a complete eyewitness view of touchdown."],["SECTION",{},["H4",{},"Keep observation separate from explanation"],["P",{},"An image of a damaged blade is direct evidence of its condition. Describing the exact motions and loads that produced it requires a reconstruction using the available flight data and engineering analysis."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","The 3D model remains an intact engineering visualization. It is not a reconstruction of the damaged aircraft after Flight 72."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.nasa.gov/news-release/after-three-years-on-mars-nasas-ingenuity-helicopter-mission-ends/","target":"_blank","rel":"noopener noreferrer"},"NASA · End of flight mission, January 25, 2024"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]],["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["BUTTON",{"class":"text-button"},"Collect evidence: What the pictures established"]]],["DETAILS",{"class":"evidence-card","data-collected":"false"},["SUMMARY",{},"A most-likely explanation",["SMALL",{},"Open record"]],["DIV",{"class":"evidence-body"},["P",{"class":"record-context"},"December 11, 2024 · later accident-investigation account"],["P",{},"NASA’s investigation linked too few trackable surface features to unreliable motion estimates. Its most-likely scenario involved excessive horizontal motion, a hard impact on a sand-ripple slope, rapid changes in attitude and damaging rotor loads."],["SECTION",{},["H4",{},"The limit of the evidence"],["P",{},"Engineers considered multiple viable scenarios. The available data supported a most-likely account, not certainty about every motion. Testing navigation over a broader range of terrain and improving robustness are sensible lessons from this case."]],["P",{"class":"record-relevance"},["STRONG",{},"Why it matters:"]," ","State which parts are observed and which are inferred. An honest uncertainty statement is part of a good engineering explanation."],["UL",{"class":"evidence-sources"},["LI",{},["A",{"href":"https://www.nasa.gov/missions/mars-2020-perseverance/ingenuity-helicopter/nasa-performs-first-aircraft-accident-investigation-on-another-world/","target":"_blank","rel":"noopener noreferrer"},"NASA · Accident investigation, December 11, 2024"," ",["SPAN",{"class":"sr-only"},"(opens in a new tab)"]]]],["BUTTON",{"class":"text-button"},"Collect evidence: A most-likely explanation"]]]],["DIV",{"class":"evidence-listen"},[[300,227]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","A short hop to check the aircraft",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_g_"},"Narration speed"],["SELECT",{"id":"_r_g_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","What the pictures established",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BU