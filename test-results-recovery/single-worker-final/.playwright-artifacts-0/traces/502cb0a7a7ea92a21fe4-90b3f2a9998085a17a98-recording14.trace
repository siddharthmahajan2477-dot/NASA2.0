ton"},"Watch Film"]],["P",{},["A",{"href":"https://www.youtube.com/watch?v=CFUmUIU_tXY","target":"_blank","rel":"noopener noreferrer"},"Watch on YouTube"]],["P",{"class":"film-privacy"},"Optional YouTube player, using the privacy-enhanced domain. YouTube still processes playback-related data. Its native controls provide play, pause, seek, volume and fullscreen where supported. Playback restrictions may appear inside the player; the app cannot detect every iframe failure."],["DETAILS",{"class":"listen-mode"},["SUMMARY",{},["svg",{"aria-hidden":"true","viewBox":"0 0 24 24","width":"22","height":"22"},["path",{"d":"M4 15V9a8 8 0 0116 0v6l-3 5H7zM7 8h10v7H7z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}]]," Helmet Listen Mode"],["P",{},"Listen to ","the mission introduction",". Original text stays available. Browser voices vary; word-by-word synchronization is not provided."],["P",{},"Audio is muted. ",["BUTTON",{"type":"button"},"Unmute audio"]],["DIV",{"class":"listen-controls"},["BUTTON",{"type":"button"},"Listen / Replay"],["BUTTON",{"type":"button","disabled":""},"Pause narration"],["BUTTON",{"type":"button"},"Stop narration"]],["LABEL",{"for":"_r_6_"},"Narration speed"],["SELECT",{"id":"_r_6_"},["OPTION",{"__playwright_selected_":"false","value":"0.75"},"0.75","×"],["OPTION",{"__playwright_selected_":"true","value":"1"},"1","×"],["OPTION",{"__playwright_selected_":"false","value":"1.25"},"1.25","×"],["OPTION",{"__playwright_selected_":"false","value":"1.5"},"1.5","×"]],["LABEL",{},"Voice volume",["INPUT",{"__playwright_value_":"1","aria-label":"Voice volume","min":"0","max":"1","step":"0.1","type":"range","value":"1"}]],["P",{"role":"status"},"Stopped"]],["DIV",{"class":"welcome-actions"},["BUTTON",{"class":"primary-button"},"Continue to Mission"],["BUTTON",{"class":"text-button"},"Skip to Mission"]],["A",{"href":"https://science.nasa.gov/mission/near-shoemaker/","target":"_blank","rel":"noopener noreferrer"},"Official mission history & sources"],["